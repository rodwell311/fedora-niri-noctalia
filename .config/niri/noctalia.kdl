layout {

    focus-ring {
        active-color   "#9ecbf7"
        inactive-color "#111416"
        urgent-color   "#ffb4ab"
    }

    border {
        active-color   "#9ecbf7"
        inactive-color "#111416"
        urgent-color   "#ffb4ab"
    }


    tab-indicator {
        active-color   "#9ecbf7"
        inactive-color "#2e5d83"
        urgent-color   "#ffb4ab"
    }

    insert-hint {
        color "#9ecbf780"
    }
}

recent-windows {
    highlight {
        active-color "#9ecbf7"
        urgent-color "#ffb4ab"
    }
}

{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "small",
    "padding": {
      "top": 1,
      "right": 2
    }
  },
  "display": {
    "separator": "  ❯ "
  },
  "modules": [
    {
      "type": "os",
      "key": "OS    ",
      "keyColor": "blue"
    },
    {
      "type": "host",
      "key": "Host  ",
      "keyColor": "cyan"
    },
    {
      "type": "kernel",
      "key": "Kernel",
      "keyColor": "magenta"
    },
    {
      "type": "shell",
      "key": "Shell ",
      "keyColor": "yellow"
    },
    {
      "type": "packages",
      "key": "Pkgs  ",
      "keyColor": "green"
    },
    {
      "type": "wm",
      "key": "WM    ",
      "keyColor": "blue"
    },
    {
      "type": "localip",
      "key": "IP    ",
      "keyColor": "red",
      "showIpv6": false,
      "showMac": false,
      "showSpeed": false,
      "showMtu": false,
      "showLoop": false
    }
  ]
}

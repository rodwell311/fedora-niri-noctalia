# ==============================================================================
# NOCTALIA SHELL V5 - TOKYO-NIGHT / CATPPUCCIN SLIM THEME
# ==============================================================================

[theme]
mode              = "dark"
source            = "builtin"
builtin           = "Tokyo-Night"
pure_black_dark   = false

[shell]
corner_radius_scale   = 0.7
button_borders        = false
input_borders         = true
popup_borders         = true
card_borders          = true
popup_shadows         = true
font_family           = "Noto Sans"
time_format           = "{:%H:%M}"
date_format           = "%A, %d %B"
polkit_agent          = true
clipboard_enabled     = true
clipboard_history_max_entries = 100
setup_wizard_enabled  = false
settings_show_advanced = true
settings_window_translucent = true

[shell.animation]
enabled = true
speed   = 1.2

[shell.shadow]
direction = "down"
alpha     = 0.35

[shell.panel]
transparency_mode     = "soft"
borders               = true
shadow                = true
list_item_background  = true
floating_layer        = "overlay"
launcher_placement    = "floating"
clipboard_placement   = "floating"
control_center_placement = "attached"
wallpaper_placement   = "attached"
session_placement     = "attached"
polkit_placement      = "floating"
launcher_position     = "center"
clipboard_position    = "center"
polkit_position       = "center"
floating_offset       = 4

[shell.launcher]
categories      = true
show_icons      = true
compact         = false
app_grid        = false
sort_by_usage   = true
show_app_origin_indicator = true

[shell.launcher.providers.calculator]
prefix = "calc"
global = true

[shell.launcher.providers.emoji]
prefix = "emo"

[shell.greeter_sync]
auto_sync = true

# ==============================================================================
# SINGLE TOP BAR CONFIGURATION (Ultra-Slim 24px)
# ==============================================================================

[bar.default]
position           = "top"
enabled            = true
auto_hide          = false
reserve_space      = true
layer              = "top"
thickness          = 24
background_opacity = 0.85
border_width       = 0.0
shadow             = false
contact_shadow     = false
panel_overlap      = 0
radius             = 0
margin_ends        = 0
margin_edge        = 0
padding            = 8
widget_spacing     = 5
hover_highlight    = true
scale              = 0.88
font_scale         = 0.88

# Compact Widget Layout
start  = ["launcher", "workspaces", "active_window"]
center = ["clock"]
end    = ["media", "tray", "volume", "brightness", "network", "battery", "control-center", "session"]

[bar.default.dead_zone.actions]
left   = "panel-toggle launcher"
right  = "panel-toggle control-center"
scroll_up   = "volume-up"
scroll_down = "volume-down"
